APP_ENV=development
APP_LOG_LEVEL=INFO

# v1.1 身份、Memory、Agent 模式。生产必须关闭开发身份并由网关注入可信主体。
DEV_IDENTITY_ENABLED=true
DEV_TENANT_ID=local
DEV_USER_ID=demo
AGENT_MODE=dynamic_planner
AGENT_MAX_HANDOFFS=8
# v1.3 动态决策路径。Planner 每轮输出一个强类型 Action；
# 本地默认 Mock 保证可复现。使用真实 LLM 时显式改为 openai/deepseek 并配置独立模型与密钥。
# shadow_dynamic_planner 保持固定工作流为结果路径，仅用于灰度观测。
PLANNER_PROVIDER=mock
PLANNER_MODEL=mock-dynamic-planner-v1
PLANNER_TIMEOUT_SECONDS=20
PLANNER_MAX_ATTEMPTS=2
PLANNER_MAX_OUTPUT_TOKENS=1200
PLANNER_MAX_DECISIONS=12
PLANNER_MAX_INVALID_ACTIONS=2
PLANNER_MAX_REPEATED_ACTIONS=2
REPLANNER_PROVIDER=deterministic
REPLANNER_MODEL=deterministic-replanner-v1
REPLANNER_TIMEOUT_SECONDS=20
REPLANNER_MAX_ATTEMPTS=2
REPLANNER_MAX_OUTPUT_TOKENS=1600
MAX_EVIDENCE_RECORDS=256
MAX_OBSERVATION_HISTORY=8
MAX_PLANNER_CONTEXT_TOKENS=6000
MAX_REPLANNER_CONTEXT_TOKENS=5000
MEMORY_STORE_BACKEND=memory
MEMORY_SQLITE_PATH=.data/travel-agent-memory.sqlite3
MEMORY_CONTEXT_MAX_TOKENS=1200
MEMORY_CONTEXT_MAX_CHARACTERS=4800

# v1.2 生产 Repository 与 Worker。
PLAN_STORE_BACKEND=memory
DATABASE_URL=
ASYNC_EXECUTION_BACKEND=local
REDIS_URL=redis://localhost:6379/0

# 需求解析 Provider：mock 为有限、确定性的测试 Fixture；openai 必须显式配置。
# OPENAI_API_KEY 只能保存在本机环境变量或未提交的 .env 中。
# OpenAI 失败不会回退 Mock；模型名必须由运行者显式选择。
REQUIREMENT_PROVIDER=mock
OPENAI_API_KEY=
REQUIREMENT_MODEL=mock-requirement-v1
REQUIREMENT_TIMEOUT_SECONDS=20
REQUIREMENT_MAX_ATTEMPTS=2
REQUIREMENT_BACKOFF_BASE_SECONDS=0.5
REQUIREMENT_MAX_BACKOFF_SECONDS=2

# DeepSeek：仅在 REQUIREMENT_PROVIDER=deepseek 时使用。
# 旧模型名 deepseek-chat/deepseek-reasoner 已停用，不应继续配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# v0.7 Grounded LLM Soft Critic。与需求解析 Provider 独立选择；disabled 完全跳过模型。
# DeepSeek/OpenAI 复用对应 API Key，但使用独立 CRITIC_MODEL。
CRITIC_PROVIDER=mock
CRITIC_MODEL=mock-soft-critic-v1
CRITIC_TIMEOUT_SECONDS=20
CRITIC_MAX_ATTEMPTS=2
CRITIC_GROUNDING_MAX_ATTEMPTS=2
CRITIC_MAX_INPUT_CHARS=24000
CRITIC_MAX_OUTPUT_TOKENS=4096
CRITIC_QUALITY_THRESHOLD=70
CRITIC_MIN_IMPROVEMENT=5
MAX_SOFT_REPLAN_ROUNDS=1

# v0.8 自然语言计划编辑。与需求解析和 Soft Critic 独立配置。
EDIT_PROVIDER=mock
EDIT_MODEL=mock-plan-edit-v1
EDIT_TIMEOUT_SECONDS=20
EDIT_MAX_ATTEMPTS=2
EDIT_MAX_OUTPUT_TOKENS=1200
PLAN_MAX_VERSIONS=20
PLAN_MAX_AFFECTED_DAYS=2

# v0.9 天气事件驱动局部重规划。amap 复用 AMAP_API_KEY；默认 Mock 可离线运行。
WEATHER_PROVIDER=mock
# AMap 主 Provider 的真实天气备用；使用当前 QWeather API Host + JWT Token。
WEATHER_FALLBACK_PROVIDER=none
QWEATHER_API_HOST=
QWEATHER_TOKEN=
WEATHER_CACHE_TTL_SECONDS=1800
WEATHER_STALE_MAX_SECONDS=21600
WEATHER_MAX_EVENTS=50
WEATHER_MAX_POI_SEARCHES=4
WEATHER_MAX_ALTERNATIVES=6
WEATHER_EXPOSURE_MIN_CONFIDENCE=0.8

# LangGraph Checkpoint：默认内存；sqlite 用于本地跨进程恢复演示。
CHECKPOINT_BACKEND=memory
CHECKPOINT_SQLITE_PATH=.data/travel-agent-checkpoints.sqlite3
PLAN_SQLITE_PATH=.data/travel-agent-plans.sqlite3

# v1.0 AgentRun、统一执行预算与安全 Trace。SQLite 仅用于本地单机演示。
RUN_STORE_BACKEND=memory
RUN_SQLITE_PATH=.data/travel-agent-runs.sqlite3
RUN_BUDGET_PROFILE=default-v1
RUN_MAX_GRAPH_STEPS=120
RUN_MAX_TOOL_CALLS=160
RUN_MAX_PROVIDER_ATTEMPTS=240
RUN_MAX_LLM_CALLS=8
RUN_MAX_LLM_ATTEMPTS=12
RUN_MAX_LLM_INPUT_CHARS=80000
RUN_MAX_INPUT_TOKENS=40000
RUN_MAX_OUTPUT_TOKENS=12000
RUN_MAX_REPAIR_ROUNDS=4
RUN_MAX_INTERRUPTS=1
RUN_MAX_CHECKPOINT_WRITES=160
RUN_MAX_TRACE_EVENTS=512
RUN_MAX_REPEATED_FINGERPRINT_COUNT=2
RUN_DEADLINE_SECONDS=120
TRACE_ATTRIBUTE_MAX_CHARS=256
# 每次 Run 的安全 Trace 同时追加到 UTF-8 文本，按 run_id 分文件。
TRACE_FILE_ENABLED=true
TRACE_FILE_DIR=.data/traces

# MCP Streamable HTTP DNS rebinding allow-list。部署到自定义域名时显式加入该 Host/Origin。
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,api:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

# 工具 Provider：mock 为离线且确定性的默认模式；amap 只在显式设置后启用。
# AMAP_API_KEY 只能保存在本机环境变量或未提交的 .env 中，不能写入此文件或提交。
# AMap 失败后会按重试预算返回工具不可用，不会回退到 Mock。
TRAVEL_PROVIDER=mock
AMAP_API_KEY=
# MAP_FALLBACK_PROVIDER=baidu 时仅对 timeout/connection/429/5xx/schema drift 切换。
MAP_FALLBACK_PROVIDER=none
BAIDU_MAP_AK=
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_ATTEMPTS=3
TOOL_BACKOFF_BASE_SECONDS=0.25
TOOL_MAX_BACKOFF_SECONDS=2
TOOL_MAX_CONCURRENCY=5
TOOL_CACHE_MAX_ENTRIES=2048
POI_CACHE_TTL_SECONDS=3600
ROUTE_CACHE_TTL_SECONDS=300
POI_QUERY_LIMIT=10
POI_CANDIDATE_LIMIT=12
POI_MAX_QUERIES=12
UNKNOWN_FACT_POLICY=assume_with_warning
AMAP_DRIVING_STRATEGY=32
MAX_WALKING_LEG_METERS=1500
USE_REAL_WALKING_ROUTES=true

# v0.6 约束优化预算：有界求解，超时后显式降级到确定性启发式。
OPTIMIZATION_MAX_SOLVE_MS=800
OPTIMIZATION_MAX_SEARCH_STATES=20000
OPTIMIZATION_CANDIDATE_LIMIT=8
OPTIMIZATION_VARIANT_COUNT=3

